---
import Analytics from '@vercel/analytics/astro'
import "../styles/global.css"
import Header from "../components/blocks/Header.astro"
import Footer from "../components/blocks/Footer.astro"

const { 
  title, 
  description, 
  image = '/images/option1.jpg',
  canonicalUrl = Astro.url.href 
} = Astro.props;

const links = [
  { label: "Reservation", href: "/#reservation" },
  { label: "Rates", href: "/#services" },
  { label: "About Us", href: "/#about" },
  { label: "Get in Touch", href: "/#contact" },
]

const socials = [
  { label: "IG", href: "#" },
  { label: "FB", href: "#" },
  { label: "TW", href: "#" },
]
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <Analytics />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Pandora Limo",
        "image": "https://www.pandoralimo.com/images/option1.jpg",
        "telephone": "+1-970-880-5218",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "620 S 10th St",
          "addressLocality": "Montrose",
          "addressRegion": "CO",
          "postalCode": "81401",
          "addressCountry": "US"
        },
        "url": "https://www.pandoralimo.com"
      }
    </script>
  </head>

  <body class="font-sans text-gray-900">
    <Header links={links} />
    <main class="pt-24">
      <slot />
    </main>
    <Footer links={links} socials={socials} />
  </body>
</html>
