---
import '../styles/global.css';
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/blocks/Hero.astro";
import ReservationSection from "../components/blocks/ServiceDetailsSection.astro";
import ServiceOptionsSection from "../components/blocks/ServiceOptionsSection.astro";
import ImageTextSection from "../components/blocks/ImageTextSection.astro";
import ContactForm from "../components/blocks/ContactForm.astro";
---

<BaseLayout title="Pandora Limo" description="Experience personalized luxury with Pandora Limo Service, dedicated to catering to the needs of the discerning traveler." image="/images/option1.jpg" canonicalUrl="https://www.pandoralimo.com/">
	<Hero
		title="Experience personalized luxury with Pandora Limo Service, dedicated to catering to the needs of the discerning traveler."
		subtitle="(970) 880-5218 | (970) 708-1041"
		ctaText="BOOK NOW"
		ctaHref="/book-now"
		backgroundImage="/images/hero.png"
		overlayOpacity={0.6}
		size="md"
	/>
	<ReservationSection
		title="Make a Reservation"
		description="Private Chauffeur Service: Call or Email Us for the Best Price in Town"
		image={{
			src: "/images/reservation.jpg",
			alt: "Restaurant interior"
		}}
		items={[
			{ label: "Montrose Airport", observations: "Private SUV (1-6 Passengers)", price: { amount: "$499", detail: "Gratuity and airport fees are included" } },
			{ label: "Telluride Airport", observations: "Private SUV (1-6 Passengers)", price: { amount: "$150", detail: "Gratuity and airport fees are included" } },
			{ label: "Durango & Grand Junction Airport", observations: "Private SUV (1-6 Passengers)", price: { amount: "$690", detail: "Gratuity and airport fees are included" } },
		]}
		contact={{
			phone: "(970) 880-5218",
			email: "reservations@pandoralimo.com",
			address: "620 S 10th St, Montrose, CO, 81401"
		}}
	/>
	<ServiceOptionsSection
		title="Rates"
		options={[
			{
			title: "Private Airport Transportation",
			image: { src: "/images/option1.jpg" },
			ctaText: "RESERVE NOW",
			ctaHref: "/book-now",
			},
			{
			title: "Weddings and Groups",
			image: { src: "/images/option2.jpg" },
			ctaText: "RESERVE NOW",
			ctaHref: "/book-now",
			},
			{
			title: "Private Car Services",
			image: { src: "/images/option3.jpg" },
			ctaText: "RESERVE NOW",
			ctaHref: "/book-now",
			},
		]}
		>
			<!-- Contenido que va al Slot "description" -->
			<div slot="description" class="space-y-4">
				<h3 class="text-xl font-semibold text-gray-200">Telluride Ski Season Luxury Transportation</h3>

				<p>
				Embark on a luxurious and seamless journey during Telluride Ski Season with our exclusive transportation rates, designed to provide a comfortable and exceptional experience for you and your party.
				</p>

				<div class="py-2 border-y border-gray-800">
				<p class="text-sm uppercase tracking-wider text-gray-400">Private SUV Transfer</p>
				<p class="text-3xl font-extrabold text-white">$499.00 <span class="text-base font-normal text-gray-400">each way</span></p>
				</div>

				<ul class="list-disc list-inside space-y-1 text-base text-gray-300">
				<li>Rates are for the entire private vehicle, not per passenger.</li>
				<li>Maximum capacity: 7 passengers per SUV.</li>
				<li>Driver gratuity and airport fees are included in the rate.</li>
				<li>Rates apply to transfers to and from the airport.</li>
				<li>Additional services or special transportation requests may be subject to additional charges.</li>
				</ul>

				<p class="italic text-gray-400 text-base">
				Enjoy a comfortable, private, and personalized transportation experience throughout your Telluride stay.
				</p>
			</div>
		</ServiceOptionsSection>
	<ImageTextSection
		image={{
			src: "/images/about.jpg",
			alt: "Luxury SUV transportation"
		}}
		backgroundImage="/images/about.jpg"
		overlayOpacity={0.6}
		title="About Us"
		text={`At Pandora Limo Service, we prioritize every detail, placing a strong emphasis on passenger safety. Our commitment to security, combined with our team of highly skilled drivers and impeccably maintained vehicles, ensures an unparalleled private transportation experience for all our passengers.

			Rest assured, our fleet is specially equipped to handle secure winter travel, 
			allowing you to embark on your journey with confidence and comfort. 
			Choose Pandora Limo Service for a travel experience that exceeds your expectations.`}
	/>
	<ContactForm
		title="Get in Touch"
		description="Send us a message and we'll get back to you shortly."
		submitLabel="Send Message"
	/>
</BaseLayout>