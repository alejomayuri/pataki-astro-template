---
interface Props {
  title?: string
  description?: string
  submitLabel?: string
}

const {
  title = "Book Now",
  description = "Fill out the form below and we’ll get back to you as soon as possible.",
  submitLabel = "Book Now"
} = Astro.props

// Reutiliza tu misma Key de Web3Forms
const ACCESS_KEY = "4c0baca3-34aa-454b-baed-d52a3efa0276"; 
---

<section id="book-now" class="py-16 bg-[#16161a]">
  <div class="max-w-2xl mx-auto px-4">
    {title && <h2 class="text-4xl font-bold text-white">{title}</h2>}
    {description && (
      <p class="mt-4 text-lg leading-relaxed whitespace-pre-line text-white">
        {description}
      </p>
    )}

    <form id="book-form" class="space-y-6 mt-8">
      <input type="hidden" name="access_key" value={ACCESS_KEY} />
      <input type="hidden" name="subject" value="Book now message" />
      
      <!-- CAMPO FANTASMA (HONEYPOT) MEJORADO -->
      <div class="hidden" aria-hidden="true" style="display: none;">
        <input type="text" name="_honeypot" tabindex="-1" autocomplete="off" />
      </div>

      <div>
        <label class="block text-sm font-medium mb-1 text-white">Name</label>
        <input type="text" name="name" required class="w-full border rounded-lg px-4 py-2 bg-[#1e1e22] text-white border-gray-700 outline-none" />
      </div>

      <div>
        <label class="block text-sm font-medium mb-1 text-white">Email</label>
        <input type="email" name="email" required class="w-full border rounded-lg px-4 py-2 bg-[#1e1e22] text-white border-gray-700 outline-none" />
      </div>

      <div>
        <label class="block text-sm font-medium mb-1 text-white">Phone</label>
        <input type="tel" name="phone" class="w-full border rounded-lg px-4 py-2 bg-[#1e1e22] text-white border-gray-700 outline-none" />
      </div>

      <div>
        <label class="block text-sm font-medium mb-1 text-white">Date</label>
        <input type="date" name="date" required class="w-full border rounded-lg px-4 py-2 bg-[#1e1e22] text-white border-gray-700 outline-none" />
      </div>

      <div>
        <label class="block text-sm font-medium mb-1 text-white">Passenger Count</label>
        <input type="number" name="passengers" min="1" required class="w-full border rounded-lg px-4 py-2 bg-[#1e1e22] text-white border-gray-700 outline-none" />
      </div>

      <div>
        <label class="block text-sm font-medium mb-1 text-white">Message</label>
        <textarea name="message" rows="5" class="w-full border rounded-lg px-4 py-2 bg-[#1e1e22] text-white border-gray-700 outline-none resize-none"></textarea>
      </div>

      <button
        id="book-submit-btn"
        type="submit"
        class="bg-black text-white px-6 py-3 rounded-lg cursor-pointer hover:bg-gray-800 transition disabled:opacity-50"
      >
        {submitLabel}
      </button>

      <div id="book-result" class="hidden mt-4 p-4 rounded-lg text-center font-medium"></div>
    </form>
  </div>
</section>

<script is:inline>
  const bookForm = document.getElementById('book-form');
  const bookResult = document.getElementById('book-result');
  const bookSubmitBtn = document.getElementById('book-submit-btn');

  bookForm.addEventListener('submit', function(e) {
    e.preventDefault();
    const formData = new FormData(bookForm);
    
    // 1. INTERCEPCIÓN ANTISPAM LOCAL
    // Si el bot cayó en la trampa, simulamos un envío exitoso sin llamar a la API
    if (formData.get('_honeypot')) {
        bookResult.classList.remove('hidden', 'bg-red-500/20', 'text-red-400');
        bookResult.classList.add('block', 'bg-green-500/20', 'text-green-400');
        bookResult.innerHTML = "We received your message!";
        bookForm.reset();
        return;
    }

    const object = Object.fromEntries(formData);
    const json = JSON.stringify(object);

    bookResult.classList.remove('hidden', 'bg-green-500/20', 'text-green-400', 'bg-red-500/20', 'text-red-400');
    bookResult.classList.add('block', 'text-white');
    bookResult.innerHTML = "Processing reservation...";
    bookSubmitBtn.disabled = true;

    fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: json
        })
        .then(async (response) => {
            if (response.status == 200) {
                bookResult.classList.add('bg-green-500/20', 'text-green-400');
                bookResult.innerHTML = "We received your message!";
                bookForm.reset();
            } else {
                bookResult.classList.add('bg-red-500/20', 'text-red-400');
                bookResult.innerHTML = "Error submitting form, please try again.";
            }
        })
        .catch(error => {
            bookResult.innerHTML = "Connection error.";
        })
        .then(function() {
            setTimeout(() => { bookSubmitBtn.disabled = false; }, 3000);
        });
  });
</script>