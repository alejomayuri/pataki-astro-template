---
interface Props {
  title?: string
  description?: string
  submitLabel?: string
}

const {
  title = "Contact Us",
  description = "Fill out the form below and we’ll get back to you as soon as possible.",
  submitLabel = "Book Now"
} = Astro.props
---

<section id="book-now" class="py-16 bg-[#16161a]">
  <div class="max-w-2xl mx-auto px-4">
    {title && <h2 class="text-4xl font-bold text-white">{title}</h2>}
    {description && (
      <p class="mt-4 text-lg leading-relaxed whitespace-pre-line text-white">
        {description}
      </p>
    )}

    <form class="space-y-6 mt-8">
      <!-- Name -->
      <div>
        <label class="block text-sm font-medium mb-1 text-white">
          Name
        </label>
        <input
          type="text"
          name="name"
          required
          class="w-full border rounded-lg px-4 py-2 bg-[#1e1e22] text-white border-gray-700 outline-none"
        />
      </div>

      <!-- Email -->
      <div>
        <label class="block text-sm font-medium mb-1 text-white">
          Email
        </label>
        <input
          type="email"
          name="email"
          required
          class="w-full border rounded-lg px-4 py-2 bg-[#1e1e22] text-white border-gray-700 outline-none"
        />
      </div>

      <!-- Phone -->
      <div>
        <label class="block text-sm font-medium mb-1 text-white">
          Phone
        </label>
        <input
          type="tel"
          name="phone"
          class="w-full border rounded-lg px-4 py-2 bg-[#1e1e22] text-white border-gray-700 outline-none"
        />
      </div>

      <!-- Date -->
      <div>
        <label class="block text-sm font-medium mb-1 text-white">
          Date
        </label>
        <input
          type="date"
          name="date"
          required
          class="w-full border rounded-lg px-4 py-2 bg-[#1e1e22] text-white border-gray-700 outline-none"
        />
      </div>

      <!-- Passenger Count -->
      <div>
        <label class="block text-sm font-medium mb-1 text-white">
          Passenger Count
        </label>
        <input
          type="number"
          name="passengers"
          min="1"
          required
          class="w-full border rounded-lg px-4 py-2 bg-[#1e1e22] text-white border-gray-700 outline-none"
        />
      </div>

      <!-- Message -->
      <div>
        <label class="block text-sm font-medium mb-1 text-white">
          Message
        </label>
        <textarea
          name="message"
          rows="5"
          class="w-full border rounded-lg px-4 py-2 bg-[#1e1e22] text-white border-gray-700 outline-none resize-none"
        ></textarea>
      </div>

      <button
        type="submit"
        class="bg-black text-white px-6 py-3 rounded-lg cursor-pointer hover:bg-gray-800 transition"
      >
        {submitLabel}
      </button>
    </form>
  </div>
</section>
