---
type Item = {
  label: string;
  observations?: string;
  price?: {
    amount: string;
    detail?: string;
  };
};

type Contact = {
  phone?: string;
  email?: string;
};

type Props = {
  title: string;
  description: string;
  image: {
    src: string;
    alt?: string;
  };
  items?: Item[];
  contact?: Contact;
};

const {
  title,
  description,
  image,
  items = [],
  contact,
} = Astro.props;
---

<section id="reservation" class="pt-16 bg-[#16161a] pb-16">
  <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-8 md:gap-16 items-center">

    <!-- Imagen -->
    <div>
        <img
            src={image.src}
            alt={image.alt ?? ""}
            class="rounded-2xl w-full object-cover"
        />
    </div>

    <!-- Contenido -->
    <div class="p-5 bg-[#0D0D0F] rounded-2xl shadow-lg">
        <h2 class="text-4xl font-bold text-white">{title}</h2>
        <p class="mt-4 text-lg text-white">{description}</p>

        <!-- Lista de precios / servicios -->
        {items.length > 0 && (
            <ul class="mt-8 space-y-3">
            {items.map((item) => (
                <li class="flex justify-between border-b pb-2 text-sm">
                  <div class="space-y-1 flex flex-col">
                    <p class="font-bold text-2xl max-w-xs text-[#c89350]">{item.label}</p>
                    <p class="text-sm text-white">{item.observations}</p>
                  </div>
                  {item.price && (
                      <div class="space-y-1 flex flex-col">
                          <span class="font-bold text-2xl text-[#c89350]">{item.price.amount}</span>
                          <span class="font-medium text-white">{item.price.detail}</span>
                      </div>
                  )}
                </li>
            ))}
            </ul>
        )}

      <!-- Contacto -->
        {contact && (
            <div class="mt-8 space-y-2 text-sm">
            {contact.phone && (
                <p class="text-lg">📞 <a href={`tel:${contact.phone}`} class="text-white">{contact.phone}</a></p>
            )}
            {contact.email && (
                <p class="text-lg">✉️ <a href={`mailto:${contact.email}`} class="text-white">{contact.email}</a></p>
            )}
            </div>
        )}
    </div>

  </div>
</section>
