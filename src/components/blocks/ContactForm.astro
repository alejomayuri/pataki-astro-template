---
interface Props {
  title?: string
  description?: string
  submitLabel?: string
}

const {
  title = "Contact Us",
  description,
  submitLabel = "Send"
} = Astro.props

const ACCESS_KEY = "4c0baca3-34aa-454b-baed-d52a3efa0276"; 
---

<section id="contact" class="py-16 bg-[#16161a]">
  <div class="max-w-2xl mx-auto px-4">
    {title && <h2 class="text-4xl font-bold text-white">{title}</h2>}
    {description && (
      <p class="mt-4 text-lg leading-relaxed whitespace-pre-line text-white">{description}</p>
    )}

    <form id="contact-form" class="space-y-6 mt-8">
      <input type="hidden" name="access_key" value={ACCESS_KEY} />
      
      <!-- CAMPO FANTASMA (HONEYPOT) MEJORADO -->
      <div class="hidden" aria-hidden="true" style="display: none;">
        <input type="text" name="_honeypot" tabindex="-1" autocomplete="off" />
      </div>

      <div>
        <label class="block text-sm font-medium mb-1 text-white">Name</label>
        <input type="text" name="name" required class="w-full border rounded-lg px-4 py-2 bg-[#1e1e22] text-white border-gray-700 outline-none" />
      </div>

      <div>
        <label class="block text-sm font-medium mb-1 text-white">Email</label>
        <input type="email" name="email" required class="w-full border rounded-lg px-4 py-2 bg-[#1e1e22] text-white border-gray-700 outline-none" />
      </div>

      <div>
        <label class="block text-sm font-medium mb-1 text-white">Message</label>
        <textarea name="message" rows="5" required class="w-full border rounded-lg px-4 py-2 bg-[#1e1e22] text-white border-gray-700 outline-none resize-none"></textarea>
      </div>

      <button
        id="submit-btn"
        type="submit"
        class="bg-black text-white px-6 py-3 rounded-lg cursor-pointer hover:bg-gray-800 transition disabled:opacity-50 disabled:cursor-not-allowed"
      >
        {submitLabel}
      </button>

      <div id="result" class="hidden mt-4 p-4 rounded-lg text-center font-medium"></div>
    </form>
  </div>
</section>

<script is:inline>
  const form = document.getElementById('contact-form');
  const result = document.getElementById('result');
  const submitBtn = document.getElementById('submit-btn');

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    const formData = new FormData(form);
    
    // 1. FILTRO ANTISPAM LOCAL (Honeypot)
    // Si el bot llenó el campo invisible, lo engañamos haciéndole creer que funcionó
    if (formData.get('_honeypot')) {
        result.classList.remove('hidden', 'bg-red-500/20', 'text-red-400');
        result.classList.add('block', 'bg-green-500/20', 'text-green-400');
        result.innerHTML = "We received your message!";
        form.reset();
        return; 
    }

    const object = Object.fromEntries(formData);
    const json = JSON.stringify(object);

    // Estado de carga
    result.classList.remove('hidden', 'bg-green-500/20', 'text-green-400', 'bg-red-500/20', 'text-red-400');
    result.classList.add('block', 'text-white');
    result.innerHTML = "Processing your message...";
    submitBtn.disabled = true;

    fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: json
        })
        .then(async (response) => {
            let json = await response.json();
            if (response.status == 200) {
                result.classList.add('bg-green-500/20', 'text-green-400');
                result.innerHTML = "We received your message!";
                form.reset();
            } else {
                console.log(response);
                result.classList.add('bg-red-500/20', 'text-red-400');
                result.innerHTML = json.message;
            }
        })
        .catch(error => {
            console.log(error);
            result.innerHTML = "Connection error.";
        })
        .then(function() {
            setTimeout(() => {
                submitBtn.disabled = false;
            }, 3000);
        });
  });
</script>