---
interface Link {
  label: string
  href: string
}

interface Social {
  label: string
  href: string
}

const {
  links = [],
  socials = []
} = Astro.props as {
  links?: Link[]
  socials?: Social[]
}
---

<footer class="bg-[#16161a] text-white py-12 border-t border-gray-800">
  <div class="max-w-7xl mx-auto px-6">

    <div class="flex flex-col md:flex-row items-center justify-between gap-10">

      <!-- Logo -->
      <a href="/" class="flex items-center">
        <img src="/images/logo.png" alt="Logo" class="h-12" />
      </a>

      <!-- Navigation + CTA -->
      <nav class="flex flex-wrap items-center justify-center gap-8 text-sm">
        {links.map((link) => (
          <a
            href={link.href}
            class="hover:text-[#c89350] transition"
          >
            {link.label}
          </a>
        ))}

        <!-- CTA -->
        <a
          href="/book-now"
          class="bg-white text-black px-6 py-2 rounded-xl font-medium hover:opacity-90 transition"
        >
          BOOK NOW
        </a>
      </nav>

      <!-- Social -->
      <div class="flex gap-4">
        {socials.map((social) => (
          <a
            href={social.href}
            target="_blank"
            class="w-10 h-10 flex items-center justify-center border border-gray-700 rounded-lg hover:border-[#c89350] hover:text-[#c89350] transition"
            aria-label={social.label}
          >
            {social.label}
          </a>
        ))}
      </div>

    </div>

    <!-- Bottom -->
    <div class="mt-10 text-center text-xs text-gray-500">
      © {new Date().getFullYear()} Pandora Limo. All rights reserved.
    </div>

  </div>
</footer>