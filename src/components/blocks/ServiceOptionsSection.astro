---
import ServiceOptionCard from "../ui/ServiceOptionCard.astro";

type Option = {
  title: string;
  image: {
    src: string;
    alt?: string;
  };
  ctaText: string;
  ctaHref: string;
};

type Props = {
  title: string;
  description?: string; // Ahora es opcional
  options: Option[];
};

const { title, description, options } = Astro.props as Props;
---

<section id="services" class="pb-16 bg-[#16161a]">
  <div class="max-w-6xl mx-auto px-6">

    <!-- Header -->
    <div class="max-w-3xl text-white">
      <h2 class="text-4xl font-bold">{title}</h2>
      
      {/* Muestra la prop simple si existe, o el Slot si se pasa contenido HTML inside */}
      {description ? (
        <p class="mt-4 text-lg whitespace-pre-line">{description}</p>
      ) : (
        <div class="mt-4 text-lg space-y-4">
          <slot name="description" />
        </div>
      )}
    </div>

    <!-- Grid -->
    <div class="mt-16 grid gap-8 md:grid-cols-3">
      {options.map((option) => (
        <ServiceOptionCard {...option} />
      ))}
    </div>

  </div>
</section>