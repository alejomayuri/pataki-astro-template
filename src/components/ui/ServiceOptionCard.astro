---
type Props = {
    title: string;
    image: {
        src: string;
        alt?: string;
    };
    ctaText: string;
    ctaHref: string;
};

const { title, image, ctaText, ctaHref } = Astro.props as Props;
---

<div class="rounded-2xl overflow-hidden border bg-[#1e1e22] flex flex-col p-3">
    <h3 class="text-xl font-bold text-center mb-2 text-white">{title}</h3>
    <div class="aspect-[4/3] overflow-hidden">
        <img
        src={image.src}
        alt={image.alt ?? ""}
        class="w-full h-full object-cover rounded-xl"
        />
    </div>


        <div class="mt-auto pt-6">
            <a
                href={ctaHref}
                class="inline-block text-center bg-black text-white py-4 rounded-xl w-full text-m font-medium hover:bg-gray-800 transition"
            >
                {ctaText}
            </a>
        </div>
</div>
